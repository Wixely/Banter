<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Named to match the source in the developer's user-level NuGet.Config, so its stored
         credentials apply here (NuGet resolves credentials by source name). CI injects
         credentials for this name before restore (see .github/workflows/ci.yml). -->
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
    <!-- The NativeAOT-LLVM compiler the web head is built with. Experimental, published by
         dotnet/runtimelab, and not on nuget.org - so it has to be named here, and mapped below. -->
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Only Wixely-family packages hit the authenticated feed; everything else restores
       from nuget.org without needing feed credentials. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <!-- The whole Cupri family, not each product by name. CupriNet.Nodestar depends on
           CupriWebRTC, which matched none of the old CupriNet/CupriFace/CupriMark patterns, so
           source mapping quietly excluded this feed for it and restore went looking on nuget.org
           (NU1101). It never failed on a developer machine because the package was already in
           ~/.nuget/packages — a clean CI runner was the first thing to actually resolve it.
           CupriTor and CupriCurve are the same shape and would have been the next two. -->
      <package pattern="Cupri*" />
      <package pattern="Bantz.*" />
      <package pattern="MCPHub.*" />
    </packageSource>
    <packageSource key="dotnet-experimental">
      <!-- EXACT IDS, not a prefix. The obvious pattern for the second one is "runtime.*", and it
           would send every runtime.* package on the restore - including runtime.win-x64.
           Microsoft.DotNet.ILCompiler, which is a DIFFERENT package that lives on nuget.org - to a
           feed that does not have them. Source mapping only supports prefix wildcards, so the RIDs
           are listed instead; add one when a new build machine needs it.

           Why this is not left to RestoreAdditionalProjectSources in the csproj: that adds a
           source, and mapping still decides which source may serve an id. It restored on my
           machine only because the packages were already in the global cache from building
           CupriFace's own sample - the exact shape of the NU1101 recorded above, where a clean CI
           runner is the first thing to actually resolve anything. -->
      <package pattern="Microsoft.DotNet.ILCompiler.LLVM" />
      <package pattern="runtime.win-x64.Microsoft.DotNet.ILCompiler.LLVM" />
      <package pattern="runtime.linux-x64.Microsoft.DotNet.ILCompiler.LLVM" />
      <package pattern="runtime.linux-arm64.Microsoft.DotNet.ILCompiler.LLVM" />
      <package pattern="runtime.browser-wasm.Microsoft.DotNet.ILCompiler.LLVM" />
    </packageSource>
  </packageSourceMapping>
</configuration>
