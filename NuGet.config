<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Named to match the source in the developer's user-level NuGet.Config, so its stored
         credentials apply here (NuGet resolves credentials by source name). CI injects
         credentials for this name before restore (see .github/workflows/ci.yml). -->
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Only Wixely-family packages hit the authenticated feed; everything else restores
       from nuget.org without needing feed credentials. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <!-- The whole Cupri family, not each product by name. CupriNet.Nodestar depends on
           CupriWebRTC, which matched none of the old CupriNet/CupriFace/CupriMark patterns, so
           source mapping quietly excluded this feed for it and restore went looking on nuget.org
           (NU1101). It never failed on a developer machine because the package was already in
           ~/.nuget/packages — a clean CI runner was the first thing to actually resolve it.
           CupriTor and CupriCurve are the same shape and would have been the next two. -->
      <package pattern="Cupri*" />
      <package pattern="Bantz.*" />
      <package pattern="MCPHub.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
