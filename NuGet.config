<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="wixely" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <wixely>
      <add key="Username" value="%CUPRIFACE_GITHUB_USER%" />
      <add key="ClearTextPassword" value="%CUPRIFACE_GITHUB_TOKEN%" />
    </wixely>
  </packageSourceCredentials>
  <!-- Only Wixely-family packages hit the authenticated feed; everything else restores
       from nuget.org without needing the PAT env vars set. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="wixely">
      <package pattern="CupriNet*" />
      <package pattern="CupriFace*" />
      <package pattern="CupriMark*" />
      <package pattern="Bantz.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
