{
  // Debug configurations for the Banter suite.
  //
  // HUMANS sign in with passwords. alice / bob (password "banter") are the development accounts
  // Banter.Server seeds into an empty database on first run, and admin / admin is the operator
  // account it creates when BANTER_ADMIN_PASSWORD is unset. None of these are secrets, which is
  // why they can live in a committed file.
  //
  // AGENTS have no passwords, here or anywhere - they authenticate with a key that never leaves
  // the machine it was made on. One key per AGENT, not per machine: dagger and scout both enrol
  // here and both run here, each with its own .banter-dev/<name>.key. Once per agent:
  //
  //   1. "Server + admin (agents page)" -> the node-graph button in the left rail -> add
  //      "dagger" (and "scout" for the delegation demos). Copy the one-time code it shows.
  //   2. Run "Enrol an agent (paste code from the agents page)" and paste the code. That
  //      writes .banter-dev/<name>.key, and the code is spent.
  //   3. Every agent configuration below now works, forever - the key is the identity.
  //
  // If an agent launch says "no key at ...", that is this list telling you where you are in it.
  // .banter-dev/ is gitignored, so keys and client settings stay out of the repository and
  // debugging never touches the real profile at %APPDATA%/Banter.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Server/bin/Debug/net10.0/Banter.Server.dll",
      "args": ["--endpoint", "tcp://127.0.0.1:7770"],
      "cwd": "${workspaceFolder}/.banter-dev",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop app (alice)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "alice",
        "--pass", "banter",
        "--room", "#main",
        "--settings", "${workspaceFolder}/.banter-dev/alice.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The agents and users pages live behind the node-graph and person buttons in the left
      // rail, and only an admin sees either.
      // The server creates the admin account on first run with BANTER_ADMIN_PASSWORD, which the
      // plain "Server" configuration leaves unset — so it is "admin", and the server says so
      // loudly at startup.
      "name": "Desktop app (admin)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "admin",
        "--pass", "admin",
        "--room", "#main",
        "--settings", "${workspaceFolder}/.banter-dev/admin.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop app (bob)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "bob",
        "--pass", "banter",
        "--room", "#main",
        "--settings", "${workspaceFolder}/.banter-dev/bob.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop app (prompt for server/user/password)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "${input:server}",
        "--user", "${input:user}",
        "--pass", "${input:password}",
        "--room", "${input:room}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // Local agent. Gets elected delegator in a room, because rooms default to sensitive
      // and only local agents are eligible to read everything in one.
      "name": "Agent (dagger, local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "dagger",
        "--key", "${workspaceFolder}/.banter-dev/dagger.key",
        "--room", "#main",
        "--llm", "http://localhost:1234/v1",
        "--model", "liquid/lfm2.5-1.2b",
        "--clearance", "sensitive",
        "--skills", "chat,code",
        "--route",
        "--system", "You are dagger, a local assistant in a group chat. Keep replies to a sentence or two."
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // SIMULATED frontier agent: it is really the same local LM Studio endpoint, flagged
      // --frontier so the election and routing rules treat it as third-party. Useful for
      // watching "local is preferred" and "sensitive stays local" actually happen. No data
      // leaves the machine when you run this.
      "name": "Agent (scout, simulated frontier)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "scout",
        "--key", "${workspaceFolder}/.banter-dev/scout.key",
        "--room", "#main",
        "--llm", "http://localhost:1234/v1",
        "--model", "qwen/qwen3-4b-2507",
        "--frontier",
        "--clearance", "public",
        "--skills", "web,github,research",
        "--cost", "5",
        "--system", "You are scout, a research assistant in a group chat. Keep replies to a sentence or two."
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // An agent whose model IS DaggerAgent, which drives external agent CLIs for us.
      //
      // Nothing here knows about Copilot: DaggerAgent serves an OpenAI-compatible endpoint
      // (POST /v1/chat/completions), so to Banter it is just another --llm. What makes it a
      // Copilot agent is DaggerAgent's own configuration. That is PLAN Path A: external agents
      // are tools INSIDE DaggerAgent rather than Banter users of their own, so a sub-agent is
      // bounded by its parent's budget instead of the room's throttle.
      //
      // Since DaggerAgent v1.8.0 the way to do it is ACP rather than a shell, which is both
      // better and safer — a long-lived session per job instead of a process per turn, activity
      // on the progress feed, and no shell access to grant at all:
      //
      //   "Tools": {
      //     "AllowCliDelegation": true,
      //     "AcpAgents": [{
      //       "Name": "copilot", "Command": "copilot", "Arguments": ["--acp"],
      //       "Enabled": true, "Protocol": "acp", "PermissionPolicy": "deny"
      //     }]
      //   }
      //
      // That exposes a delegate_to_acp_copilot tool. Keep PermissionPolicy at "deny": "ask"
      // routes the child's permission requests to whoever is driving the job, and nobody is
      // driving a chat room — it would stall until PermissionTimeoutSeconds and then deny anyway.
      //
      // NEEDS: DaggerAgent running in HTTP mode on :5090 (its quick start) with an upstream
      // model. It is a separate repo — github.com/Wixely/DaggerAgent.
      //
      // --frontier is not decoration: whatever this agent is handed reaches Copilot, and through
      // it GitHub. That keeps it out of sensitive rooms and lets the local agent be delegator.
      "name": "Agent (scout, via DaggerAgent + CLIs)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "scout",
        "--key", "${workspaceFolder}/.banter-dev/scout.key",
        "--room", "#main",
        "--llm", "http://localhost:5090/v1",
        "--model", "dagger",
        "--frontier",
        "--clearance", "public",
        "--skills", "web,github,research",
        "--cost", "5",
        "--system", "You are scout, a research assistant in a group chat. Keep replies to a sentence or two."
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The one-time step that turns a code from the agents page into a key on this machine.
      // Enrolment generates the keypair HERE and sends only the public half - which is why this
      // is a launch configuration and not something the server could do for you. Run it once per
      // agent; it refuses to overwrite an existing key.
      "name": "Enrol an agent (paste code from the agents page)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--enrol", "${input:enrolCode}",
        "--key", "${workspaceFolder}/.banter-dev/${input:agentName}.key",
        "--server", "tcp://127.0.0.1:7770"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "CLI client (bob)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Cli/bin/Debug/net10.0/Banter.Cli.dll",
      "args": ["--server", "tcp://127.0.0.1:7770", "--user", "bob", "--pass", "banter"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The server on a CupriNet node instead of a socket: this is what the browser client
      // talks to. Full C# debugging, same as any other coreclr config.
      //
      // --seed-file drops this node's link where the web head can fetch it from its own origin,
      // so the browser pre-fills its Server field instead of needing a 400-character paste on
      // every run. The file is gitignored and rewritten every 30s, because links rotate.
      "name": "Mesh server (Nodestar + WebRTC)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mesh-server",
      "program": "${workspaceFolder}/src/Banter.Server.Nodestar/bin/Debug/net10.0/banter-nodestar.dll",
      "args": [
        "--data", "${workspaceFolder}/.banter-dev/nodestar",
        "--network", "banter-dev",
        "--seed-file", "${workspaceFolder}/src/Banter.App.Web/wwwroot/seed.json"
      ],
      "env": { "BANTER_ADMIN_PASSWORD": "banter" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The web head, in a browser. VS Code's BUILT-IN JS debugger — nothing Blazor-named, and
      // nothing Blazor in the app either (see src/Banter.App.Web: no Razor, no components, just
      // Microsoft.NET.Sdk.WebAssembly, which is the WASM build SDK).
      //
      // WHAT YOU GET: breakpoints, stepping and the console in main.js — the WebRTC dial, the
      // canvas blit, the input plumbing. Plus everything the app logs, and the boot log element.
      //
      // WHAT YOU DO NOT GET: breakpoints in the client's C#. The SDK ships a Mono debug proxy for
      // that (WasmAppHost prints it as "Debug at url"), but the only VS Code adapter that speaks
      // to it is the one the C# extension calls "blazorwasm" — a name, not a dependency, though
      // it is built around Blazor's boot shape and is not wired here. It matters less than it
      // sounds: the head is one line of CupriFace.Web.Mono plus a WebRTC data channel, and the
      // behaviour worth stepping through lives in Banter.App and Banter.Client.Core, which the
      // test suite covers headlessly.
      "name": "Web client (Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "serve-web",
      "url": "http://localhost:7775",
      "webRoot": "${workspaceFolder}/src/Banter.App.Web/wwwroot",
      "browserLaunchLocation": "workspace"
    },
    {
      "name": "Web client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "serve-web",
      "url": "http://localhost:7775",
      "webRoot": "${workspaceFolder}/src/Banter.App.Web/wwwroot",
      "browserLaunchLocation": "workspace"
    },
    {
      "name": "Attach to process",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      // The web stack: a Banter server on a CupriNet node, and the browser client that reaches
      // it over WebRTC. The server seeds its link, so the client's Server field is already
      // filled — sign in as admin / banter.
      //
      // Both halves are debuggable, in different debuggers: C# breakpoints in the server through
      // coreclr, and JS breakpoints in the client through the browser. They are separate
      // processes on purpose — the browser is a real peer here, not a hosted page.
      "name": "Mesh server + web client",
      "configurations": ["Mesh server (Nodestar + WebRTC)", "Web client (Edge)"],
      "stopAll": true
    },
    {
      // Server, the desktop client, and two agents on different backends: dagger straight onto a
      // local model through LM Studio, scout through DaggerAgent (which can drive Copilot and
      // other agent CLIs as tools). One local and one third-party is the interesting pair —
      // dagger is eligible to be delegator and to see sensitive rooms, scout is neither, so the
      // routing rules are visible rather than theoretical.
      //
      // NEEDS: LM Studio on :1234 for dagger, DaggerAgent on :5090 for scout, and both agents
      // enrolled (see the header).
      "name": "Server + alice + local agent + DaggerAgent",
      "configurations": [
        "Server",
        "Desktop app (alice)",
        "Agent (dagger, local)",
        "Agent (scout, via DaggerAgent + CLIs)"
      ],
      "stopAll": true
    },
    {
      // The one to pick for a first smoke test: server plus two clients in one room.
      "name": "Server + alice + bob",
      "configurations": ["Server", "Desktop app (alice)", "Desktop app (bob)"],
      "stopAll": true
    },
    {
      // Managing agents: sign in as the operator, open the node-graph button in the left rail,
      // and add one. Creating it hands back a one-time enrolment code — the agent's own machine turns
      // that into a key, so nothing secret is copied out of this window except the code itself,
      // and that is spent the moment it is used.
      "name": "Server + admin (agents page)",
      "configurations": ["Server", "Desktop app (admin)"],
      "stopAll": true
    },
    {
      // The operator and an ordinary user side by side, for watching an agent appear in the room
      // as soon as it enrols.
      "name": "Server + admin + alice",
      "configurations": ["Server", "Desktop app (admin)", "Desktop app (alice)"],
      "stopAll": true
    },
    {
      "name": "Server + alice",
      "configurations": ["Server", "Desktop app (alice)"],
      "stopAll": true
    },
    {
      // Chat with an agent: talk to dagger in #main. Needs LM Studio on :1234, and dagger
      // enrolled (see the header).
      "name": "Server + alice + agent",
      "configurations": ["Server", "Desktop app (alice)", "Agent (dagger, local)"],
      "stopAll": true
    },
    {
      // The delegation demo: two agents, so one gets elected delegator and the other waits to
      // be handed work. dagger (local) wins; scout (simulated frontier) is ineligible in a
      // sensitive room and stays quiet until dagger names it. Both need enrolling first (see
      // the header).
      "name": "Server + alice + two agents (delegation)",
      "configurations": [
        "Server",
        "Desktop app (alice)",
        "Agent (dagger, local)",
        "Agent (scout, simulated frontier)"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "server",
      "type": "promptString",
      "description": "Server URI (tcp://host:port, or a cupri:// mesh link)",
      "default": "tcp://127.0.0.1:7770"
    },
    { "id": "user", "type": "promptString", "description": "Username", "default": "alice" },
    {
      "id": "password",
      "type": "promptString",
      "description": "Password (not stored)",
      "password": true
    },
    { "id": "room", "type": "promptString", "description": "Room to join", "default": "#main" },
    {
      "id": "agentName",
      "type": "promptString",
      "description": "Agent name (the key is written to .banter-dev/<name>.key)",
      "default": "dagger"
    },
    {
      "id": "enrolCode",
      "type": "promptString",
      "description": "One-time enrolment code from the agents page (banter-enrol-...)",
      "password": true
    }
  ]
}
