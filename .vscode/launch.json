{
  // Debug configurations for the Banter suite.
  //
  // The credentials below are the development accounts Banter.Server seeds into an empty
  // database on first run (it prints them at startup): humans alice / bob and agents
  // dagger / scout, all with password "banter".
  // They are not secrets, which is why they can live in a committed file - a real deployment
  // creates accounts with admin tooling and supplies the password via --pass or BANTER_PASS.
  //
  // Each client writes its settings under .banter-dev/ so debugging never touches the real
  // profile at %APPDATA%/Banter.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Server/bin/Debug/net10.0/Banter.Server.dll",
      "args": ["--endpoint", "tcp://127.0.0.1:7770"],
      "cwd": "${workspaceFolder}/.banter-dev",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop app (alice)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "alice",
        "--pass", "banter",
        "--room", "#main",
        "--settings", "${workspaceFolder}/.banter-dev/alice.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop app (bob)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "bob",
        "--pass", "banter",
        "--room", "#main",
        "--settings", "${workspaceFolder}/.banter-dev/bob.json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Desktop app (prompt for server/user/password)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.App.Desktop/bin/Debug/net10.0/banter.dll",
      "args": [
        "--server", "${input:server}",
        "--user", "${input:user}",
        "--pass", "${input:password}",
        "--room", "${input:room}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // Local agent. Gets elected delegator in a room, because rooms default to sensitive
      // and only local agents are eligible to read everything in one.
      "name": "Agent (dagger, local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "dagger",
        "--pass", "banter",
        "--room", "#main",
        "--llm", "http://localhost:1234/v1",
        "--model", "liquid/lfm2.5-1.2b",
        "--clearance", "sensitive",
        "--skills", "chat,code",
        "--route",
        "--system", "You are dagger, a local assistant in a group chat. Keep replies to a sentence or two."
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // SIMULATED frontier agent: it is really the same local LM Studio endpoint, flagged
      // --frontier so the election and routing rules treat it as third-party. Useful for
      // watching "local is preferred" and "sensitive stays local" actually happen. No data
      // leaves the machine when you run this.
      "name": "Agent (scout, simulated frontier)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "scout",
        "--pass", "banter",
        "--room", "#main",
        "--llm", "http://localhost:1234/v1",
        "--model", "qwen/qwen3-4b-2507",
        "--frontier",
        "--clearance", "public",
        "--skills", "web,github,research",
        "--cost", "5",
        "--system", "You are scout, a research assistant in a group chat. Keep replies to a sentence or two."
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // Backed by the GitHub Copilot CLI as a subprocess rather than an HTTP endpoint, so it needs
      // no LM Studio — just `copilot` on PATH and logged in.
      //
      // --frontier is not decoration: the room's contents go to GitHub, which is exactly what that
      // flag means. It keeps this agent out of sensitive rooms and off sensitive requests, and
      // lets the local agent win the delegator election (PLAN 8a).
      //
      // Copilot's OWN tools stay off. This agent is prompted by whatever the room says to it, so
      // its tools would be the room's tools — and Banter runs tools server-side under per-agent
      // grants with every call announced, which its own would bypass. --copilot-tools turns them
      // on if you ever want that, and you probably do not.
      "name": "Agent (scout, GitHub Copilot CLI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Warden/bin/Debug/net10.0/banter-warden.dll",
      "args": [
        "--server", "tcp://127.0.0.1:7770",
        "--user", "scout",
        "--pass", "banter",
        "--room", "#main",
        "--copilot",
        "--model", "github-copilot",
        "--frontier",
        "--clearance", "public",
        "--skills", "web,github,research",
        "--cost", "5",
        "--system", "You are scout, a research assistant in a group chat. Keep replies to a sentence or two."
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "CLI client (bob)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Banter.Cli/bin/Debug/net10.0/Banter.Cli.dll",
      "args": ["--server", "tcp://127.0.0.1:7770", "--user", "bob", "--pass", "banter"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The server on a CupriNet node instead of a socket: this is what the browser client
      // talks to. Full C# debugging, same as any other coreclr config.
      //
      // --seed-file drops this node's link where the web head can fetch it from its own origin,
      // so the browser pre-fills its Server field instead of needing a 400-character paste on
      // every run. The file is gitignored and rewritten every 30s, because links rotate.
      "name": "Mesh server (Nodestar + WebRTC)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mesh-server",
      "program": "${workspaceFolder}/src/Banter.Server.Nodestar/bin/Debug/net10.0/banter-nodestar.dll",
      "args": [
        "--data", "${workspaceFolder}/.banter-dev/nodestar",
        "--network", "banter-dev",
        "--seed-file", "${workspaceFolder}/src/Banter.App.Web/wwwroot/seed.json"
      ],
      "env": { "BANTER_ADMIN_PASSWORD": "banter" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The web head, in a browser. VS Code's BUILT-IN JS debugger — nothing Blazor-named, and
      // nothing Blazor in the app either (see src/Banter.App.Web: no Razor, no components, just
      // Microsoft.NET.Sdk.WebAssembly, which is the WASM build SDK).
      //
      // WHAT YOU GET: breakpoints, stepping and the console in main.js — the WebRTC dial, the
      // canvas blit, the input plumbing. Plus everything the app logs, and the boot log element.
      //
      // WHAT YOU DO NOT GET: breakpoints in the client's C#. The SDK ships a Mono debug proxy for
      // that (WasmAppHost prints it as "Debug at url"), but the only VS Code adapter that speaks
      // to it is the one the C# extension calls "blazorwasm" — a name, not a dependency, though
      // it is built around Blazor's boot shape and is not wired here. It matters less than it
      // sounds: the head is one line of CupriFace.Web.Mono plus a WebRTC data channel, and the
      // behaviour worth stepping through lives in Banter.App and Banter.Client.Core, which the
      // test suite covers headlessly.
      "name": "Web client (Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "serve-web",
      "url": "http://localhost:7775",
      "webRoot": "${workspaceFolder}/src/Banter.App.Web/wwwroot",
      "browserLaunchLocation": "workspace"
    },
    {
      "name": "Web client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "serve-web",
      "url": "http://localhost:7775",
      "webRoot": "${workspaceFolder}/src/Banter.App.Web/wwwroot",
      "browserLaunchLocation": "workspace"
    },
    {
      "name": "Attach to process",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      // The web stack: a Banter server on a CupriNet node, and the browser client that reaches
      // it over WebRTC. The server seeds its link, so the client's Server field is already
      // filled — sign in as admin / banter.
      //
      // Both halves are debuggable, in different debuggers: C# breakpoints in the server through
      // coreclr, and JS breakpoints in the client through the browser. They are separate
      // processes on purpose — the browser is a real peer here, not a hosted page.
      "name": "Mesh server + web client",
      "configurations": ["Mesh server (Nodestar + WebRTC)", "Web client (Edge)"],
      "stopAll": true
    },
    {
      // Server, the desktop client, and two agents with different backends: dagger on a local
      // model through LM Studio, scout on the GitHub Copilot CLI. One local and one third-party is
      // the interesting pair — dagger is eligible to be delegator and to see sensitive rooms,
      // scout is neither, so the routing rules are visible rather than theoretical.
      //
      // Needs LM Studio on :1234 for dagger, and `copilot` on PATH and logged in for scout.
      "name": "Server + alice + local agent + Copilot agent",
      "configurations": [
        "Server",
        "Desktop app (alice)",
        "Agent (dagger, local)",
        "Agent (scout, GitHub Copilot CLI)"
      ],
      "stopAll": true
    },
    {
      // The one to pick for a first smoke test: server plus two clients in one room.
      "name": "Server + alice + bob",
      "configurations": ["Server", "Desktop app (alice)", "Desktop app (bob)"],
      "stopAll": true
    },
    {
      "name": "Server + alice",
      "configurations": ["Server", "Desktop app (alice)"],
      "stopAll": true
    },
    {
      // Chat with an agent: talk to dagger in #main. Needs LM Studio running on :1234.
      "name": "Server + alice + agent",
      "configurations": ["Server", "Desktop app (alice)", "Agent (dagger, local)"],
      "stopAll": true
    },
    {
      // The delegation demo: two agents, so one gets elected delegator and the other waits to
      // be handed work. dagger (local) wins; scout (simulated frontier) is ineligible in a
      // sensitive room and stays quiet until dagger names it.
      "name": "Server + alice + two agents (delegation)",
      "configurations": [
        "Server",
        "Desktop app (alice)",
        "Agent (dagger, local)",
        "Agent (scout, simulated frontier)"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "server",
      "type": "promptString",
      "description": "Server URI (tcp://host:port, or a cupri:// mesh link)",
      "default": "tcp://127.0.0.1:7770"
    },
    { "id": "user", "type": "promptString", "description": "Username", "default": "alice" },
    {
      "id": "password",
      "type": "promptString",
      "description": "Password (not stored)",
      "password": true
    },
    { "id": "room", "type": "promptString", "description": "Room to join", "default": "#main" }
  ]
}
