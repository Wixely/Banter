{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Banter.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      // The mesh server and the web head are NOT in Banter.slnx (the web head needs the
      // wasm-tools workload, and the mesh server restores a local Nodestar build), so the
      // default `build` task does not touch them.
      "label": "build-mesh-server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Banter.Server.Nodestar/Banter.Server.Nodestar.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Banter.App.Web/Banter.App.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      // PUBLISHES the web head, because that is what the mesh server serves. There is no separate
      // dev server for it any more: whatever carries the mesh hands out the page that dials it,
      // which is one origin instead of two and settles which of them is the real one.
      //
      // A publish rather than a build, and Release: the published wwwroot IS the deployable
      // client - fingerprinted assets, import map, the lot - and a plain build output is not that.
      // Slow from cold, which is the honest price of there being one server.
      "label": "publish-web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/Banter.App.Web/Banter.App.Web.csproj",
        "--configuration",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      // Builds the mesh server AND publishes the client it hands out, so F5 cannot start a node
      // with a stale bundle beside it - or with none at all.
      "label": "mesh-server-and-client",
      "dependsOrder": "sequence",
      "dependsOn": ["build-mesh-server", "publish-web"],
      "problemMatcher": []
    },
    {
      // The browser must not open before the node's web front is listening, or it gets a
      // connection error instead of the page. Polled rather than slept: the node takes about ten
      // seconds from cold and longer on a tired machine, and a fixed wait is either too short to
      // work or too long to sit through every single time.
      //
      // --retry-all-errors because the failure being waited out is "connection refused", which is
      // not an HTTP status and which plain --retry ignores.
      //
      // "process", NOT "shell": on Windows a shell task runs in PowerShell, where `curl` is an
      // ALIAS FOR Invoke-WebRequest - which does not understand one flag below and fails the
      // launch before the browser opens. A process task execs the binary straight off PATH, which
      // is curl on every platform this repo is developed on.
      "label": "wait-for-mesh-web",
      "type": "process",
      "command": "curl",
      "args": [
        "--retry", "90",
        "--retry-delay", "1",
        "--retry-all-errors",
        "--silent",
        "--fail",
        "--output", "${workspaceFolder}/.banter-dev/.web-ready",
        "http://localhost:7774/_nodestar/app"
      ],
      "problemMatcher": []
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/Banter.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
