{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Banter.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      // The mesh server and the web head are NOT in Banter.slnx (the web head needs the
      // wasm-tools workload, and the mesh server restores a local Nodestar build), so the
      // default `build` task does not touch them.
      "label": "build-mesh-server",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Banter.Server.Nodestar/Banter.Server.Nodestar.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Banter.App.Web/Banter.App.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      // Serves the web head on the fixed port in Properties/launchSettings.json, and stays up.
      // The browser configs wait for the "App url" line rather than racing it.
      //
      // No dependsOn: `dotnet run` builds. Depending on build-web as well would rebuild the
      // project a second time, and a rebuild UNDERNEATH a server that is already serving is the
      // one thing to avoid here — scripts are fingerprinted, so the running server keeps
      // advertising a filename the rebuild has just replaced, the import 404s, and the page loads
      // to a blank canvas with no error on it. If that happens, restart this task.
      "label": "serve-web",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/src/Banter.App.Web/Banter.App.Web.csproj"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "WasmAppHost",
          "endsPattern": "App url:"
        }
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/Banter.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
