<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>banter</AssemblyName>
    <RootNamespace>Banter.App.Desktop</RootNamespace>
    <!-- Console output is still wanted for usage text and connect errors before the window opens. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <ProjectReference Include="../Banter.Transport.CupriNet/Banter.Transport.CupriNet.csproj" />
    <ProjectReference Include="../Banter.Voice.OpenAI/Banter.Voice.OpenAI.csproj" />
    <ProjectReference Include="../Banter.Voice.Wyoming/Banter.Voice.Wyoming.csproj" />
    <PackageReference Include="CupriFace.Shell" Version="0.15.0" />
    <!-- Decoding a cached preview into a clipboard DIB. Transitive via CupriFace, declared
         because this project uses it directly. -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <!-- Microphone. Bantz's recorders normalise to the 16 kHz mono the speech engines take and
         already handle both desktop platforms, so the head adapts them rather than reimplementing
         device handling twice. -->
    <PackageReference Include="Bantz.Capture" Version="0.2.3" />
    <!-- Speaker. Bantz is dictation-only and ships no playback, so this half is ours; Linux goes
         through aplay and needs no package at all. -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- Local transcription: the desktop default (PLAN §6a), so dictation works with no speech
         server and no audio leaving the machine. Wraps native whisper.cpp and downloads a
         ~148 MB model on first use, which is why it is a head dependency and not a core one. -->
    <PackageReference Include="Bantz.Speech.Whisper" Version="0.2.3" />
    <!-- Global push-to-talk: keyboard chords, and gamepad and mouse buttons for free. Replaces
         the hand-rolled RegisterHotKey work the plan originally carried (PLAN §6a). -->
    <PackageReference Include="Bantz.Input" Version="0.2.3" />
  </ItemGroup>
</Project>
