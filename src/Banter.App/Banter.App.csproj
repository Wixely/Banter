<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- the shared UI, useful only to a head in this repository. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.Client.Core/Banter.Client.Core.csproj" />
    <ProjectReference Include="../Banter.Voice/Banter.Voice.csproj" />
    <!-- Engine only. Host heads (Desktop/Android/Web) bring their own CupriFace.* host package,
         which keeps this project buildable and testable headlessly on any platform. -->
    <PackageReference Include="CupriFace" Version="0.27.0" />
    <!-- Reading a server link out of a camera frame. The pure-managed core, not one of the
         platform bindings: it decodes from a luminance array, which is what every camera already
         hands us, so nothing platform-shaped reaches the shared app. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
