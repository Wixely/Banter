<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- the shared UI, useful only to a head in this repository. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The RUNNING app's icon: the desktop window and taskbar, the web page's favicon, and the
         phone's recents card all read it through CupriApp.Icon. It is embedded rather than copied
         beside the executable so every head gets it without each one shipping its own file - and
         so it cannot go missing from a published zip.

         This is NOT the installed app's icon. A Windows .exe and an Android launcher entry are
         read out of the built artefact before any of this code exists, which is why the desktop
         head carries banter.ico and the Android head carries Resources/mipmap-*. -->
    <EmbeddedResource Include="Assets/logo.png" LogicalName="Assets/logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.Client.Core/Banter.Client.Core.csproj" />
    <ProjectReference Include="../Banter.Voice/Banter.Voice.csproj" />
    <!-- Engine only. Host heads (Desktop/Android/Web) bring their own CupriFace.* host package,
         which keeps this project buildable and testable headlessly on any platform. -->
    <PackageReference Include="CupriFace" Version="0.27.0" />
    <!-- Reading a server link out of a camera frame. The pure-managed core, not one of the
         platform bindings: it decodes from a luminance array, which is what every camera already
         hands us, so nothing platform-shaped reaches the shared app. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
