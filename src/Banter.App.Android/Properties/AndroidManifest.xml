<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Talking to the server. RECORD_AUDIO is asked for again at runtime the moment somebody opens
       voice, not at launch - the same in-context rule the camera follows below, and for the same
       reason. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Reading a server's QR off a screen. Asked for at the moment somebody taps Scan, not at
       launch: a chat client that wants the camera before you have signed in is one people refuse,
       and a refusal is sticky. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- A phone with no camera can still be a perfectly good Banter client, so this is not a
       requirement to install. -->
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <application android:label="Banter" android:supportsRtl="true" />
</manifest>
