<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Talking to the server. RECORD_AUDIO is asked for again at runtime the moment somebody opens
       voice, not at launch - the same in-context rule the camera follows below, and for the same
       reason. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Reading a server's QR off a screen. Asked for at the moment somebody taps Scan, not at
       launch: a chat client that wants the camera before you have signed in is one people refuse,
       and a refusal is sticky. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- A phone with no camera can still be a perfectly good Banter client, so this is not a
       requirement to install. -->
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- Holding the connection open while the app is in the background. Declared as dataSync, which
       is the honest name for it: this is a socket kept alive, not a media session or a navigation.
       Android 14 caps that type at roughly six hours a day and then ends the service, which is why
       the setting behind it promises to stay connected rather than to stay connected forever. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- Telling you that somebody named you. Runtime-requested from Android 13, and asked for when
       the setting that needs it is turned on rather than at launch - the same rule as the camera
       and the microphone. Refusing it is not fatal: the connection is still held, the notification
       that says so is simply not shown. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- roundIcon as well as icon: a launcher that wants a circular entry asks for that one, and
       without it some of them fall back to the legacy square and mask it themselves. Both point
       at the same adaptive icon, which is what lets the launcher pick its own shape. -->
  <application
    android:label="Banter"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true" />
</manifest>
