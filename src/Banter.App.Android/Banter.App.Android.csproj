<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>uk.co.wixely.banter</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The version people see, from the one place the repository's version lives. It was
         hardcoded 0.1.0 and had been wrong since the day the repo moved past it - the same
         staleness that the CI package version had. CI overrides both this and ApplicationVersion
         on a tag. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Banter.App.Android</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <ProjectReference Include="../Banter.Voice.OpenAI/Banter.Voice.OpenAI.csproj" />
    <ProjectReference Include="../Banter.Voice.Wyoming/Banter.Voice.Wyoming.csproj" />
    <PackageReference Include="CupriFace.Android" Version="0.18.0" />
  </ItemGroup>
</Project>
