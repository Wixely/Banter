<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>uk.co.wixely.banter</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The version people see, from the one place the repository's version lives. It was
         hardcoded 0.1.0 and had been wrong since the day the repo moved past it - the same
         staleness that the CI package version had. CI overrides both this and ApplicationVersion
         on a tag. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Banter.App.Android</RootNamespace>
    <!-- CoreCLR, because Mono miscompiles the engine and the app dies before its first frame.
         CupriFace.Android pins this itself from 0.25.0, and this line was removed once as
         redundant - but a pin delivered by a NuGet package cannot survive a FIRST restore, and
         that is the only kind a clean machine does. NuGet evaluates the project with
         ExcludeRestorePackageImports=true during restore, so the package's .props is not imported
         then: UseMonoRuntime is still true, restore fetches the Mono packs, and then the build -
         now with the package's pin applied - asks for CoreCLR packs nobody downloaded. NETSDK1112,
         on a green build everywhere it had been built before. Here it is set in the project, which
         restore does read. Raised as CupriFace#191 and fixed in 0.26.1: the package now emits
         CUPRI0002 naming this line rather than leaving a bare NETSDK1112, so the line stays -
         it is the documented fix, not a workaround waiting to be removed. -->
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <!-- The mesh, as the web head reaches it: a Pilgrimage to the site banter-nodestar serves,
         pinning the SITE's Signet. Deliberately the Shrine path and not Banter.Transport.CupriNet
         - the Arcanum channels that head speaks have no shipped server listening for them, so a
         phone wired that way would have nothing to dial but a test harness. -->
    <ProjectReference Include="../Banter.Transport.Shrine/Banter.Transport.Shrine.csproj" />
    <ProjectReference Include="../Banter.Voice.OpenAI/Banter.Voice.OpenAI.csproj" />
    <ProjectReference Include="../Banter.Voice.Wyoming/Banter.Voice.Wyoming.csproj" />
    <PackageReference Include="CupriFace.Android" Version="0.26.1" />
    <!-- The crypto suite the Pilgrimage runs on. The web head takes the same one. -->
    <PackageReference Include="CupriNet.Alembic.BouncyCastle" Version="0.6.2" />
  </ItemGroup>
</Project>
