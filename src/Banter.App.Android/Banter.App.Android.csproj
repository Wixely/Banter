<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>uk.co.wixely.banter</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The version people see, from the one place the repository's version lives. It was
         hardcoded 0.1.0 and had been wrong since the day the repo moved past it - the same
         staleness that the CI package version had. CI overrides both this and ApplicationVersion
         on a tag. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Banter.App.Android</RootNamespace>
    <!-- CoreCLR, because Mono miscompiles the engine and the app dies before its first frame.
         CupriFace.Android pins this itself from 0.25.0, and this line was removed once as
         redundant - but a pin delivered by a NuGet package cannot survive a FIRST restore, and
         that is the only kind a clean machine does. Package .targets are imported from the assets
         file, which does not exist yet when restore runs: UseMonoRuntime is still true, restore
         fetches the Mono packs, and then the build - now with the package's pin applied - asks for
         CoreCLR packs nobody downloaded. NETSDK1112, on a green build everywhere it had been
         built before. Here it is evaluated before any package is imported, so restore hears it.
         Reproduced by hiding microsoft.netcore.app.runtime.android-* from the NuGet cache; put it
         back and this line is what makes the difference. -->
    <UseMonoRuntime>false</UseMonoRuntime>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <ProjectReference Include="../Banter.Voice.OpenAI/Banter.Voice.OpenAI.csproj" />
    <ProjectReference Include="../Banter.Voice.Wyoming/Banter.Voice.Wyoming.csproj" />
    <PackageReference Include="CupriFace.Android" Version="0.25.0" />
  </ItemGroup>
</Project>
