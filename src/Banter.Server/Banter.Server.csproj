<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- an application, not a library - it is deployed as a container or a service. -->
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Tools run server-side, so the MCP client lives here and agents never hold credentials. -->
    <PackageReference Include="MCPHub.Proxy" Version="0.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Banter.Core/Banter.Core.csproj" />
    <ProjectReference Include="../Banter.Protocol/Banter.Protocol.csproj" />
  </ItemGroup>
</Project>
