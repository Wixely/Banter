<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    What a CupriFace.Web.Mono app's project file is: the WebAssembly SDK, the host, and the app.

    This used to carry the Skia and HarfBuzz wasm natives, WasmBuildNative, two embedded Noto
    faces, and a workaround for a Mono AOT bug in CupriFace's own code. All of that is the host's
    now (CupriFace#73), which is where it always belonged — a workaround for someone else's
    compiler bug is not something a consumer can know to re-test.
  -->
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by [JSImport]; the source generator emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Browser-only by definition; the JSExport/JSImport platform hints are expected here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!--
      TRIMMED. 9.1 MB of brotli and 208 assemblies become 5.3 MB and 50 - measured both ways into
      clean directories, because publishing over a previous publish leaves the old assemblies
      behind and makes the trimmed build look bigger than the untrimmed one.

      Two things were in the way, and only one of them was the one this file used to name.

      The JSON wire format was the first, and nothing here ever selected it: four IL2026 errors,
      all System.Text.Json, all in BanterCodec, for a debugging convenience that makes frames
      readable in a log. A browser has no such log. The head switches it off through the feature
      switch below and ILLink removes the reflection-based serializer behind it.

      MessagePack was the second, and it is real: IL2104, exactly as this file always said. It is
      suppressed rather than fixed, which is only defensible because of what now stands behind it.
      The fear was specific - a formatter trimmed away would "build and then fail on the first
      frame it decodes" - and that is precisely what MeshChatTests catches: a browser, over a real
      mesh, whose message has to survive a MessagePack round trip and land in the server's
      database. It passes on the trimmed head. The warnings are about reflective paths reached
      through the non-generic Serialize(Type, ...) overloads; the formatters those need are
      source-generated and statically referenced, so they survive.

      That test running on every push is the whole justification for the line below it. If it is
      ever removed or skipped, this suppression stops being honest and the payload should go back.
    -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- AOT is opt-in via `-p:Aot=true`, never via Configuration: a previous AOT publish leaves
         artifacts in obj/ that make a later plain run paint a blank canvas. The host's
         buildTransitive targets supply the interpreter workaround AOT needs. -->
    <RunAOTCompilation Condition="'$(Aot)' == 'true'">true</RunAOTCompilation>
    <WasmEmitSymbolMap Condition="'$(Aot)' == 'true'">true</WasmEmitSymbolMap>
    <WasmNativeDebugSymbols Condition="'$(Aot)' == 'true'">false</WasmNativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Trim="true" is what makes this a TRIMMER fact rather than only a run-time one: without it
         ILLink still sees a property it cannot fold, and the four call sites survive. -->
    <RuntimeHostConfigurationOption Include="Banter.Protocol.JsonWireFormatSupported"
                                    Value="false" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser host, and the same app the desktop and Android heads run. -->
    <PackageReference Include="CupriFace.Web.Mono" Version="0.27.0" />
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <!-- The conduit transport's CLIENT half. Deliberately not Banter.Transport.Shrine.Nodestar:
         that brings Kestrel, and a browser has no business downloading an HTTP server to join a
         chat room. -->
    <ProjectReference Include="../Banter.Transport.Shrine/Banter.Transport.Shrine.csproj" />
    <PackageReference Include="CupriNet.Alembic.BouncyCastle" Version="0.6.2" />
  </ItemGroup>

</Project>
