<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    What a CupriFace.Web.Mono app's project file is: the WebAssembly SDK, the host, and the app.

    This used to carry the Skia and HarfBuzz wasm natives, WasmBuildNative, two embedded Noto
    faces, and a workaround for a Mono AOT bug in CupriFace's own code. All of that is the host's
    now (CupriFace#73), which is where it always belonged — a workaround for someone else's
    compiler bug is not something a consumer can know to re-test.
  -->
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by [JSImport]; the source generator emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Browser-only by definition; the JSExport/JSImport platform hints are expected here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!--
      The WebAssembly SDK trims Release publishes by default. We do not, because MessagePack is not
      trim-safe and this app cannot talk without it.

      BanterCodec already avoids the part that matters at run time: it resolves formatters through
      MessagePack's source generator rather than StandardResolver, so nothing here needs
      Reflection.Emit, which a browser does not have. But the library still reaches the serializer
      reflectively from the outside — the non-generic Serialize(Type, object, options) goes through
      CompiledMethods, MessagePackSerializerOptions.Standard resolves a resolver by type NAME, and
      MessagePackSecurity hashes through MakeGenericMethod. ILLink cannot see through any of that,
      reports it (IL2104, "assembly 'MessagePack' produced trim warnings"), and TreatWarningsAsErrors
      turns the report into NETSDK1144. Silencing it would not make the code reachable again: it
      would ship a head that builds and then fails on the first frame it decodes, which is worse
      than a large one.

      The price is the whole BCL: about 12.6 MB brotli, against roughly half that trimmed. Worth
      revisiting when MessagePack ships trim annotations — the resolver work that would be needed on
      our side is already done.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- AOT is opt-in via `-p:Aot=true`, never via Configuration: a previous AOT publish leaves
         artifacts in obj/ that make a later plain run paint a blank canvas. The host's
         buildTransitive targets supply the interpreter workaround AOT needs. -->
    <RunAOTCompilation Condition="'$(Aot)' == 'true'">true</RunAOTCompilation>
    <WasmEmitSymbolMap Condition="'$(Aot)' == 'true'">true</WasmEmitSymbolMap>
    <WasmNativeDebugSymbols Condition="'$(Aot)' == 'true'">false</WasmNativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- The browser host, and the same app the desktop and Android heads run. -->
    <PackageReference Include="CupriFace.Web.Mono" Version="0.15.0" />
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <!-- The conduit transport's CLIENT half. Deliberately not Banter.Transport.Shrine.Nodestar:
         that brings Kestrel, and a browser has no business downloading an HTTP server to join a
         chat room. -->
    <ProjectReference Include="../Banter.Transport.Shrine/Banter.Transport.Shrine.csproj" />
    <PackageReference Include="CupriNet.Alembic.BouncyCastle" Version="0.6.2" />
  </ItemGroup>

</Project>
