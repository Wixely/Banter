<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    What a CupriFace.Web.Mono app's project file is: the WebAssembly SDK, the host, and the app.

    This used to carry the Skia and HarfBuzz wasm natives, WasmBuildNative, two embedded Noto
    faces, and a workaround for a Mono AOT bug in CupriFace's own code. All of that is the host's
    now (CupriFace#73), which is where it always belonged — a workaround for someone else's
    compiler bug is not something a consumer can know to re-test.
  -->
  <PropertyGroup>
    <!-- an application, not a library. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by [JSImport]; the source generator emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Browser-only by definition; the JSExport/JSImport platform hints are expected here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- AOT is opt-in via `-p:Aot=true`, never via Configuration: a previous AOT publish leaves
         artifacts in obj/ that make a later plain run paint a blank canvas. The host's
         buildTransitive targets supply the interpreter workaround AOT needs. -->
    <RunAOTCompilation Condition="'$(Aot)' == 'true'">true</RunAOTCompilation>
    <WasmEmitSymbolMap Condition="'$(Aot)' == 'true'">true</WasmEmitSymbolMap>
    <WasmNativeDebugSymbols Condition="'$(Aot)' == 'true'">false</WasmNativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- The browser host, and the same app the desktop and Android heads run. -->
    <PackageReference Include="CupriFace.Web.Mono" Version="0.15.0" />
    <ProjectReference Include="../Banter.App/Banter.App.csproj" />
    <!-- The conduit transport's CLIENT half. Deliberately not Banter.Transport.Shrine.Nodestar:
         that brings Kestrel, and a browser has no business downloading an HTTP server to join a
         chat room. -->
    <ProjectReference Include="../Banter.Transport.Shrine/Banter.Transport.Shrine.csproj" />
    <PackageReference Include="CupriNet.Alembic.BouncyCastle" Version="0.6.2" />
  </ItemGroup>

</Project>
