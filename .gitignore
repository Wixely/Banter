bin/
obj/
artifacts/
*.user
.vs/
.idea/

# Local debug profile: settings, mesh identity and SQLite db written by the VS Code
# launch configs, kept out of the real profile at %APPDATA%/Banter.
.banter-dev/

# Written at runtime by `banter-nodestar --seed-file` so the web client can pre-fill its Server
# field. A link, not a secret, but it is machine- and run-specific and belongs to nobody else.
src/Banter.App.Web/wwwroot/seed.json

# Design scratch, not part of the repo: the visual sample the app was built from.
preview.html

# The server's default SQLite database. `--db sqlite` with no `--connection` resolves
# "Data Source=banter.db" against the working directory, so running the server from the repo
# root — which is the obvious way to try it — drops a database into the working tree.
banter.db
banter.db-shm
banter.db-wal
