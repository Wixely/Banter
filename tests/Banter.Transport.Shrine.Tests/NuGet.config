<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-scoped, and temporary. CupriNet.Nodestar 0.1.0-alpha.5 has not reached the Wixely feed
  (its publish run died on a GitHub artifact-storage quota, not on anything in the code), so this
  project restores it from a local build instead. The version is suffixed `.local` upstream
  precisely so it can never be confused with the feed build: NuGet caches by version, and a shared
  version string would let whichever landed first win silently on every machine.

  This file lives beside the project rather than at the repo root so the rest of the solution — and
  CI — restore exactly as before. Delete it, and switch the PackageReference to 0.1.0-alpha.5, the
  moment the feed has it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
    <add key="nodestar-local" value="C:\Users\anmcguinness\Documents\nodestar-alpha5-local\packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="CupriNet*" />
      <package pattern="CupriFace*" />
      <package pattern="CupriMark*" />
      <package pattern="Bantz.*" />
      <package pattern="MCPHub.*" />
    </packageSource>
    <!-- More specific than CupriNet*, so the Nodestar packages come from the local build and
         everything else in the family still comes from the feed. -->
    <packageSource key="nodestar-local">
      <package pattern="CupriNet.Nodestar*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
